###############################################
# WAVAULT Backend .env (ejemplo)
###############################################

# --- Groq (ruta primaria de IA para demo) ---
# Obtener API key: https://console.groq.com/keys
# Activa Groq como primario para evitar cuotas de Gemini
#############################################
#   Google Gemini API Configuration          #
#############################################
# Obtén tu API key en: https://aistudio.google.com/apikey
# Opción A (simple): una sola key
GEMINI_API_KEY=tu_api_key_aqui
# Opción B (múltiples keys): CSV
# GEMINI_API_KEYS=keyA,keyB,keyC
# Opción C (múltiples keys): variables numeradas
# GEMINI_API_KEY_2=otra_key
# GEMINI_API_KEY_3=otra_key_mas

#############################################
#   Groq (Llama 3) - Camino Primario        #
#############################################
# Activa Groq como primario (1=on, 0=off)
USE_GROQ_PRIMARY=1
# Key de Groq: https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key
# Modelo por defecto (ajustable si deseas otro)
GROQ_MODEL=llama-3.1-8b-instant

# Instrucciones:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores con tus keys reales
# 3. NO subas el archivo .env a GitHub

# --- Gemini (fallback automático multi-key) ---
# Obtén tu(s) API key(s): https://aistudio.google.com/apikey
# Opción A: CSV de keys
# GEMINI_API_KEYS=keyA,keyB,keyC
# Opción B: Variables numeradas (hasta _10)
# GEMINI_API_KEY=primer_key
# GEMINI_API_KEY_2=segunda_key
# GEMINI_API_KEY_3=tercera_key

# Nota: El archivo real debe llamarse .env y NO debe subirse al repositorio.
# Pasos:
# 1) Copia este archivo como .env
# 2) Rellena GROQ_API_KEY (recomendado) y/o GEMINI_API_KEY(S)
# 3) Guarda y reinicia el backend si es necesario
